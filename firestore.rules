rules_version = '2';

// Reglas de seguridad de Bookly.
// Se publican con:  firebase deploy --only firestore:rules
// (o copiándolas en Firebase Console → Firestore Database → Reglas → Publicar).
//
// Idea principal: todo lo que tiene que ver con DINERO (citas pagadas,
// pedidos, movimientos, cuentas de Stripe) solo lo escribe el servidor
// (Cloud Functions). La app solo puede leer lo que le corresponde.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Los negocios de ejemplo se llaman demo_1, demo_2...
    function isDemo(id) {
      return id.matches('demo_[0-9]+');
    }

    // Producto o servicio con precio y existencias razonables.
    function validItem() {
      return request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price <= 100000
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && shortText(request.resource.data.name, 80);
    }

    // Texto con largo máximo.
    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    // ---------------------------------------------------------------- Usuarios
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'isClient', 'isBusiness', 'mode', 'updatedAt'])
        && shortText(request.resource.data.name, 80)
        && request.resource.data.email == myEmail()
        && request.resource.data.mode in ['client', 'business'];
      allow delete: if false;

      // Movimientos de la billetera: solo el servidor los escribe.
      match /movements/{id} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // --------------------------------------------------------------- Negocios
    match /businesses/{businessId} {
      allow read: if signedIn();

      // Los negocios de ejemplo solo se pueden CREAR (una vez); nadie los edita.
      allow create: if signedIn() && isDemo(businessId)
        && request.resource.data.demo == true;

      // Un negocio real lo crea y edita solo su dueño (id = uid del dueño).
      allow create, update: if isOwner(businessId)
        && shortText(request.resource.data.name, 80)
        && request.resource.data.ownerUid == request.auth.uid
        // El correo de avisos siempre es el de la cuenta dueña.
        && request.resource.data.ownerEmail == myEmail()
        // Un negocio real no se puede marcar como "de ejemplo" (no cobra).
        && request.resource.data.get('demo', false) == false
        // Nadie se puede poner calificación a sí mismo.
        && (request.resource.data.get('rating', 0) == 0
            || (resource != null && request.resource.data.rating == resource.data.rating));
      allow delete: if false;

      match /items/{itemId} {
        allow read: if signedIn();
        allow create: if signedIn() && (isOwner(businessId) || isDemo(businessId))
          && validItem();
        allow update: if isOwner(businessId) && validItem();
        allow delete: if isOwner(businessId);
      }

      match /gallery/{photoId} {
        allow read: if signedIn();
        allow write: if isOwner(businessId);
      }

      // Horarios ocupados (sin datos personales). Solo el servidor escribe.
      match /busy/{appointmentId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Ingresos del negocio: solo el dueño los ve; solo el servidor escribe.
      match /movements/{id} {
        allow read: if isOwner(businessId);
        allow write: if false;
      }
    }

    // Si el negocio ya puede cobrar en línea (lo escribe el servidor).
    match /paymentStatus/{businessId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------- Publicaciones
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (request.resource.data.businessId == request.auth.uid
            || isDemo(request.resource.data.businessId))
        && shortText(request.resource.data.text, 500);
      allow update: if false;
      allow delete: if signedIn() && resource.data.businessId == request.auth.uid;
    }

    // ------------------------------------------------------------------ Citas
    // Solo las ven el negocio y el cliente. Crear, cancelar o cambiar una
    // cita se hace SIEMPRE a través del servidor.
    match /appointments/{id} {
      allow read: if signedIn()
        && (resource.data.businessId == request.auth.uid
            || resource.data.clientUid == request.auth.uid
            || resource.data.clientEmail == myEmail());
      allow write: if false;
    }

    // ---------------------------------------------------------------- Pedidos
    match /orders/{id} {
      allow read: if signedIn()
        && (resource.data.buyerUid == request.auth.uid
            || resource.data.businessId == request.auth.uid);
      allow write: if false;
    }

    // ------------------------------------------- Datos privados del servidor
    match /stripeCustomers/{uid} { allow read, write: if false; }
    match /stripeAccounts/{uid}  { allow read, write: if false; }
    match /stripeEvents/{id}     { allow read, write: if false; }
    match /rateLimits/{id}       { allow read, write: if false; }

    // Cualquier otra colección queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
